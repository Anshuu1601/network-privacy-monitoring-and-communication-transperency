# Backend configuration
DATABASE_URL=sqlite:///./database/network_privacy.db
API_HOST=127.0.0.1
API_PORT=8000

# Leave empty to auto-detect; set to a specific interface name (e.g. "Wi-Fi", "eth0")
CAPTURE_INTERFACE=

LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# Data retention in days (0 = unlimited). Old flow records are cleaned by this window.
RETENTION_DAYS=30

# Flow aggregation timeout before a connection is marked closed
FLOW_TIMEOUT_SECONDS=60
FLUSH_INTERVAL_SECONDS=2

# Expiring IP→domain cache (seconds). Kept short so traffic is never attributed
# to the wrong site after an IP changes hands.
DNS_CACHE_TTL_SECONDS=300

# Minimum interval between individual flow WebSocket events; full live snapshots
# are still broadcast every FLUSH_INTERVAL_SECONDS.
WS_MIN_INTERVAL_SECONDS=1.0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode generates clearly-labeled synthetic traffic when live capture is unavailable
DEMO_MODE=false
DEMO_TICK_SECONDS=1.5

# Privacy score weights (must sum to 100 for a balanced score)
WEIGHT_ENCRYPTION=60
WEIGHT_PROTOCOL=20
WEIGHT_UNENCRYPTED=20